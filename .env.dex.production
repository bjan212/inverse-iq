# ============================================
# DEX TRADING - PRODUCTION ENVIRONMENT
# ============================================
# Created: December 2024
# Purpose: Production RPC endpoints and DEX configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# RPC ENDPOINTS - PRODUCTION
# ============================================
# Get free API keys from:
# - Alchemy: https://www.alchemy.com/
# - Infura: https://infura.io/
# - QuickNode: https://www.quicknode.com/

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Fallback: https://eth.llamarpc.com

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# Fallback: https://bsc-dataseed1.defibit.io/

# Arbitrum
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Fallback: https://arb1.arbitrum.io/rpc

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Fallback: https://polygon-rpc.com

# Base (Coinbase L2)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Fallback: https://mainnet.base.org

# Optimism
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Fallback: https://mainnet.optimism.io

# ============================================
# DEX PROTOCOL CONFIGURATION
# ============================================

# Enable/Disable DEX Protocols
UNISWAP_ENABLED=true
PANCAKESWAP_ENABLED=true
SUSHISWAP_ENABLED=true
CURVE_ENABLED=false
BALANCER_ENABLED=false

# Arbitrum DEX (GMX, etc.)
ARBITRUM_DEX_ENABLED=false

# Polygon DEX
POLYGON_DEX_ENABLED=false

# ============================================
# TRADING SETTINGS
# ============================================

# Slippage Tolerance (0.01 = 1%)
DEX_SLIPPAGE_TOLERANCE=0.01

# Transaction Deadline (seconds)
DEX_TRANSACTION_DEADLINE=600

# Minimum Liquidity (USD)
DEX_MIN_LIQUIDITY=100000

# Gas Price Multiplier (1.1 = 10% above current)
DEX_GAS_MULTIPLIER=1.1

# Maximum Gas Price (Gwei)
DEX_MAX_GAS_PRICE=100

# ============================================
# RATE LIMITING
# ============================================

# RPC Calls per second
RPC_RATE_LIMIT=10

# API Calls per minute
API_RATE_LIMIT=60

# ============================================
# MONITORING & ALERTS
# ============================================

# Enable monitoring
DEX_MONITORING_ENABLED=true

# Alert on high gas prices (Gwei)
GAS_ALERT_THRESHOLD=80

# Alert on low liquidity (USD)
LIQUIDITY_ALERT_THRESHOLD=50000

# ============================================
# SECURITY
# ============================================

# Enable transaction simulation before execution
SIMULATE_TRANSACTIONS=true

# Require confirmation for trades above this amount (USD)
CONFIRMATION_THRESHOLD=1000

# Maximum trade size (USD)
MAX_TRADE_SIZE=10000

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
EMAIL_HOST=smtp.protonmail.ch
EMAIL_PORT=587
EMAIL_USER=notify@xrypt.net
EMAIL_PASS=YOUR_EMAIL_PASSWORD
EMAIL_FROM=XryptNotifications <notify@xrypt.net>

# ============================================
# TELEGRAM NOTIFICATIONS (Optional)
# ============================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/dex-trading.log

# ============================================
# NOTES
# ============================================
# 1. Replace YOUR_ALCHEMY_API_KEY with your actual API keys
# 2. For free tier, use public RPC endpoints (already provided as fallbacks)
# 3. Start with testnet before using mainnet
# 4. Monitor gas prices and adjust DEX_MAX_GAS_PRICE accordingly
# 5. Keep slippage low (1-2%) for production
