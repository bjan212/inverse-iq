# ============================================================================
# Xrypt Trading Service - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://xrypt.net

# Admin API Key (generate a secure random string)
ADMIN_API_KEY=your-secure-admin-api-key-here

# ----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Optional - for notifications)
# ----------------------------------------------------------------------------
# SMTP Server Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Email Authentication
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# From Address
EMAIL_FROM=Xrypt Notifications <noreply@xrypt.net>

# ProtonMail Bridge Example (if using ProtonMail):
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_SECURE=false
# EMAIL_USER=notify@xrypt.net
# EMAIL_PASS=your-bridge-password

# ----------------------------------------------------------------------------
# TELEGRAM SERVICE CONFIGURATION (Optional - for notifications)
# ----------------------------------------------------------------------------
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Default Chat ID (optional - for testing)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ----------------------------------------------------------------------------
# EXCHANGE API KEYS (Optional - for testing data collection)
# ----------------------------------------------------------------------------
# Binance API Keys (Read-Only)
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# Bybit API Keys (Read-Only)
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

# OKX API Keys (Read-Only)
OKX_API_KEY=your-okx-api-key
OKX_API_SECRET=your-okx-api-secret
OKX_PASSPHRASE=your-okx-passphrase

# MEXC API Keys (Read-Only)
MEXC_API_KEY=your-mexc-api-key
MEXC_API_SECRET=your-mexc-api-secret

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# File-based database paths (relative to project root)
PATTERN_DB_PATH=./data/hybrid_pattern_database.json
SIGNAL_TRACKER_PATH=./data/active_signals.json
SUBSCRIBER_DB_PATH=./data/subscribers.json

# ----------------------------------------------------------------------------
# AI ENGINE CONFIGURATION
# ----------------------------------------------------------------------------
# Minimum confidence threshold for signals (0-100)
MIN_SIGNAL_CONFIDENCE=70

# Signal expiry time in hours
SIGNAL_EXPIRY_HOURS=4

# Data pipeline monitoring interval in milliseconds
PIPELINE_INTERVAL=60000

# ----------------------------------------------------------------------------
# PAYMENT CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Crypto payment addresses
USDT_TRC20_ADDRESS=your-trc20-wallet-address
USDT_ERC20_ADDRESS=your-erc20-wallet-address
BTC_ADDRESS=your-btc-wallet-address

# Payment tiers (in USDT)
PAYMENT_TIER_A=200
PAYMENT_TIER_B=150
PAYMENT_TIER_C=100
PAYMENT_TIER_D=50

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/app.log

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# Max requests per window
RATE_LIMIT_MAX=100

# Submission rate limit (per hour)
SUBMISSION_RATE_LIMIT=5

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# Session secret (generate a secure random string)
SESSION_SECRET=your-secure-session-secret

# JWT secret (if using JWT authentication)
JWT_SECRET=your-secure-jwt-secret

# Encryption key for sensitive data (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# ----------------------------------------------------------------------------
# MONITORING & ANALYTICS (Optional)
# ----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=your-sentry-dsn

# Google Analytics ID
GA_TRACKING_ID=your-ga-tracking-id

# ----------------------------------------------------------------------------
# WEBSOCKET CONFIGURATION
# ----------------------------------------------------------------------------
# WebSocket ping interval in milliseconds
WS_PING_INTERVAL=30000

# WebSocket connection timeout in milliseconds
WS_TIMEOUT=60000

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. Email Service: Configure either Gmail, ProtonMail, or any SMTP server
# 2. Telegram Service: Get bot token from @BotFather on Telegram
# 3. Exchange APIs: Only use READ-ONLY API keys, never enable withdrawals
# 4. Security: Generate strong random strings for secrets and keys
# 5. Rate Limiting: Adjust based on your expected traffic
# 6. All optional services can be left empty if not needed
# ============================================================================
